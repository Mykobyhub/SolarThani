# ===== Solar Panel Thailand — Next.js Environment Variables =====
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local ขึ้น git)

# Database (Postgres — Neon หรือ self-hosted ก็ได้ ใช้ connection string เดียวกัน)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT — ใช้เซ็น/ตรวจ session cookie ต้องเป็นค่าสุ่มยาวๆ (แนะนำ 128 hex chars)
# generate ได้ด้วย: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Email (Nodemailer + Gmail SMTP)
# ค่าจริงที่ระบบใช้ส่งอีเมลตั้งอยู่ใน DB ผ่านหน้า Admin > ตั้งค่า > SMTP (ตาราง site_content) เป็นหลัก
# ค่าด้านล่างเป็นแค่ fallback เผื่อยังไม่เคยตั้งค่าในแอดมิน — ถ้าใส่ SMTP_PASS ต้องเป็น Gmail App Password
# (16 ตัวอักษร) ไม่ใช่รหัสผ่าน Gmail ปกติ สร้างได้ที่ https://myaccount.google.com/apppasswords
# (ต้องเปิด 2-Step Verification ก่อน)
SMTP_USER=
SMTP_PASS=

# App URL (OAuth callbacks + ลิงก์ในอีเมล) — ต้องตรงกับโดเมนจริงที่ deploy
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Site URL (SEO — robots.txt, sitemap.xml, OG/Twitter image resolution) — ต้องตรงกับโดเมนจริงที่ deploy
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NODE_ENV=development
