# ===== Solar Panel Thailand — Next.js Environment Variables =====
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local ขึ้น git)

# Database (Postgres — Neon หรือ self-hosted ก็ได้ ใช้ connection string เดียวกัน)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT — ใช้เซ็น/ตรวจ session cookie ต้องเป็นค่าสุ่มยาวๆ (แนะนำ 128 hex chars)
# generate ได้ด้วย: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Email (Nodemailer — SMTP provider เป็น config ได้, ค่า default ในโค้ดคือ Hostinger)
# ค่าจริงที่ระบบใช้ส่งอีเมลตั้งอยู่ใน DB ผ่านหน้า Admin > ตั้งค่า > SMTP (ตาราง site_content:
# smtp_user/smtp_pass/smtp_host/smtp_port) เป็นหลัก — เปลี่ยนผู้ให้บริการอีเมลได้จากหน้านั้นโดยตรง
# ไม่ต้องแก้โค้ดหรือ redeploy ค่าด้านล่างเป็นแค่ fallback เผื่อยังไม่เคยตั้งค่าในแอดมิน
# ถ้าไม่ตั้ง SMTP_HOST/SMTP_PORT จะ default เป็น smtp.hostinger.com พอร์ต 465 (SSL)
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465

# App URL (OAuth callbacks + ลิงก์ในอีเมล) — ต้องตรงกับโดเมนจริงที่ deploy
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Site URL (SEO — robots.txt, sitemap.xml, OG/Twitter image resolution) — ต้องตรงกับโดเมนจริงที่ deploy
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Uploads storage — โฟลเดอร์เก็บไฟล์ที่อัปโหลด (โลโก้, ผลงาน, รูปบทความ ฯลฯ)
# ไม่ตั้งก็ได้สำหรับ dev (จะ fallback ไปที่ ../uploads อัตโนมัติ)
# บน VPS ควรตั้งเป็น absolute path ไปยัง persistent disk แยกจากโฟลเดอร์โค้ด เช่น /var/www/solarpanel/uploads
# UPLOADS_DIR=/var/www/solarpanel/uploads

NODE_ENV=development
